{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/gateway",
      "destination": "/api/gateway"
    },
    {
        "source": "/robots.txt",
        "destination": "/api/robots.js"
    }
  ]
}
